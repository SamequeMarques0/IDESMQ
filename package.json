{
  "name": "SMQIDE",
  "version": "0.3.0",
  "description": "IDE For me and You",
  "author": "SMQIDE <samequemarques@contato.com>",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer.js --bundle --minify --outfile=dist/renderer.js",
    "watch": "esbuild src/renderer.js --bundle --sourcemap --outfile=dist/renderer.js --watch",
    "start": "npm run build:renderer && electron .",
    "rebuild": "electron-builder install-app-deps",
    "icons": "node scripts/prepare-icons.js",
    "dist": "npm run icons && npm run build:renderer && electron-builder --publish never",
    "dist:win": "npm run icons && npm run build:renderer && electron-builder --win --publish never",
    "dist:mac": "npm run icons && npm run build:renderer && electron-builder --mac --publish never",
    "dist:linux": "npm run icons && npm run build:renderer && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.samequemarqueide.app",
    "productName": "SMQIDE",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "electron/**",
      "src/index.html",
      "src/style.css",
      "dist/**",
      "assets/256.png",
      "assets/256.ico"
    ],
    "npmRebuild": false,
    "asarUnpack": ["**/node_modules/node-pty/**"],
    "win": {
      "icon": "assets/256.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FrontIDE",
      "installerIcon": "assets/256.ico",
      "uninstallerIcon": "assets/256.ico",
      "installerHeaderIcon": "assets/256.ico"
    },
    "mac": {
      "icon": "assets/256.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": ["dmg"]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "synopsis": "IDE leve para desenvolvimento front end",
      "target": ["AppImage", "deb"]
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "electron": "latest",
    "electron-builder": "latest",
    "esbuild": "latest"
  }
}
